FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY frontend/package.json frontend/package.json
COPY realtime-node/package.json realtime-node/package.json
RUN npm ci --workspace frontend
COPY frontend frontend
RUN npm run build --workspace frontend

FROM nginxinc/nginx-unprivileged:stable-alpine
ENV PORT=8080 \
    NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 \
    NGINX_ENVSUBST_FILTER="^(PORT|DJANGO_UPSTREAM|REALTIME_UPSTREAM|NGINX_LOCAL_RESOLVERS)$"
COPY infra/render-nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
