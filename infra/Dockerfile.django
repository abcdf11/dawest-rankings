FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend-django/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home dawest
COPY --chown=dawest:dawest backend-django .
USER dawest
RUN USE_SQLITE=1 USE_REDIS=0 python manage.py collectstatic --noinput
EXPOSE 8000
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "60", "--access-logfile", "-", "--error-logfile", "-"]
